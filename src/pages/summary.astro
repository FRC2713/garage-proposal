---
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PageNav from "../components/PageNav.astro";
import { benefits, img } from "../data/proposal";
---

<AppLayout title="Executive summary | Garage robotics lab proposal">
  <PageHeader
    slug="summary"
    title="One space where students learn to engineer"
    image="03-garage-field-hero"
  >
    A robotics lab in the garage, built in phases, with district storage kept in
    place.
  </PageHeader>

  <section
    class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-[1fr_1.1fr]"
  >
    <div class="space-y-4 text-base leading-relaxed text-muted-foreground">
      <p>
        The garage is used today for storage. We propose converting it, together
        with the adjoining cage, Room 6, and Room 3, into a robotics lab for Red
        Hawk Robotics and other Melrose students.
      </p>
      <p>
        The design, which we call Option B, puts a 3/4-scale practice field in
        the garage bay, separates fabrication into a fenced cage, uses Room 6
        for assembly, and turns Room 3 into a classroom. The district's existing
        mezzanine and pallet racking stay where they are, so storage that must
        remain can be consolidated onto them.
      </p>
      <p>
        We will do the work in four phases. Each phase is useful on its own, and
        the first two need no new utilities.
      </p>
      <figure class="mt-8 overflow-hidden rounded-xl ring-1 ring-foreground/10">
        <img
          src={img("10-aerial-cutaway-ne")}
          alt="Cutaway view of the garage with the practice field, mezzanine, and fabrication cage"
          class="aspect-video w-full object-cover"
        />
      </figure>
    </div>
    <div class="grid content-start gap-4 sm:grid-cols-2">
      {
        benefits.map((c) => (
          <div class="rounded-xl bg-card p-5 shadow-xs ring-1 ring-foreground/10">
            <c.icon className="size-5 text-primary" aria-hidden="true" />
            <h2 class="mt-3 font-semibold">{c.title}</h2>
            <p class="mt-1 text-sm text-muted-foreground">{c.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <PageNav slug="summary" />
</AppLayout>
