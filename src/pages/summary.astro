---
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PageNav from "../components/PageNav.astro";
import ProgramScale from "../components/ProgramScale.astro";
import {
  benefits,
  currentRooms,
  img,
  labArea,
  program,
  roundArea,
  spaceStandards,
} from "../data/proposal";

const fmt = (n: number) => n.toLocaleString("en-US");
const perStandard = spaceStandards.map((s) => s.perPerson);
---

<AppLayout title="Executive summary | Garage robotics lab proposal">
  <PageHeader
    slug="summary"
    title="One space where students learn to engineer"
    image="03-garage-field-hero"
  >
    A robotics lab in the garage, built in phases, reusing the existing
    mezzanine and racking.
  </PageHeader>

  <section
    class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-[1fr_1.1fr]"
  >
    <div class="space-y-4 text-base leading-relaxed text-muted-foreground">
      <p>
        Red Hawk Robotics serves {program[0]!.value} Melrose students, {
          program[1]!.value
        } of them on the FRC team. The team works in Rooms 3 and 6, where we regularly
        fit more than {currentRooms.people} people into about {
          fmt(roundArea(currentRooms.sqft))
        } sq ft. Shop and lab standards call for at least {
          Math.min(...perStandard)
        } to {Math.max(...perStandard)} sq ft per student, so those rooms are past
        capacity and leave no room to grow. Next door, the garage is used for storage.
        We propose converting the garage and the adjoining cage, together with Rooms
        3 and 6, into one robotics lab of about {fmt(roundArea(labArea))} sq ft.
      </p>
      <p>
        The design puts a 3/4-scale practice field in the garage bay, separates
        fabrication into a fenced cage, uses Room 6 for assembly, and turns Room
        3 into a classroom. The existing mezzanine and pallet racking stay and
        become lab storage. District items still in the garage are consolidated
        first, then phased out on a schedule agreed with the district.
      </p>
      <p>
        The work is staged in four phases, each ending with a district check-in.
        The first two need no new utilities, and only the last, the fabrication
        cage, waits on permits and contractor work.
      </p>
      <figure class="mt-8 overflow-hidden rounded-xl ring-1 ring-foreground/10">
        <img
          src={img("10-aerial-cutaway-ne")}
          alt="Cutaway view of the garage with the practice field, mezzanine, and fabrication cage"
          class="aspect-video w-full object-cover"
        />
      </figure>
    </div>
    <div class="grid content-start gap-4 sm:grid-cols-2">
      {
        benefits.map((c) => (
          <div class="rounded-xl bg-card p-5 shadow-xs ring-1 ring-foreground/10">
            <c.icon className="size-5 text-primary" aria-hidden="true" />
            <h2 class="mt-3 font-semibold">{c.title}</h2>
            <p class="mt-1 text-sm text-muted-foreground">{c.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t bg-card/50">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-xl font-semibold">Our program today</h2>
      <p class="mt-2 max-w-3xl text-muted-foreground">
        The lab would serve a program that is already large and growing fast.
      </p>
      <div class="mt-6">
        <ProgramScale />
      </div>
    </div>
  </section>

  <PageNav slug="summary" />
</AppLayout>
