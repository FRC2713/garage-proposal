---
import { ArrowRight } from "lucide-react";
import AppLayout from "../layouts/AppLayout.astro";
import { href, img, sections, stats } from "../data/proposal";
---

<AppLayout title="A robotics lab for Melrose students | Red Hawk Robotics">
  <section class="relative isolate overflow-hidden bg-foreground text-white">
    <img
      src={img("01-aerial-cutaway-sw")}
      alt=""
      class="absolute inset-0 -z-10 size-full object-cover opacity-35"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-black/85 via-black/60 to-black/20"
    >
    </div>
    <div class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
      <p
        class="text-xs font-semibold tracking-[0.18em] text-white/80 uppercase"
      >
        Proposal to the Superintendent of Schools · Melrose, Massachusetts
      </p>
      <h1
        class="mt-4 max-w-3xl text-4xl leading-tight font-bold tracking-tight sm:text-5xl"
      >
        Turn the garage into a robotics lab for Melrose students
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-white/85">
        Red Hawk Robotics, FRC Team 2713, asks for access to the garage so
        students can design, build, and test robots in one safe, supervised
        space. Our plan keeps the existing mezzanine and racking in place and
        moves in phases.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={href("summary")}
          class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground hover:bg-primary/90"
        >
          Read the summary <ArrowRight className="size-4" aria-hidden="true" />
        </a>
        <a
          href={href("gallery")}
          class="inline-flex items-center gap-2 rounded-lg bg-white/10 px-5 py-3 text-sm font-semibold text-white ring-1 ring-white/30 hover:bg-white/20"
        >
          See the space
        </a>
      </div>
    </div>
  </section>

  <section aria-label="Key figures" class="border-b bg-card">
    <dl
      class="mx-auto grid max-w-6xl grid-cols-2 gap-px bg-border md:grid-cols-4"
    >
      {
        stats.map((s) => (
          <div class="bg-card px-5 py-6">
            <dt class="text-xs text-muted-foreground">{s.label}</dt>
            <dd class="mt-1 text-2xl font-bold tracking-tight tabular-nums">
              {s.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="text-2xl font-bold tracking-tight">Inside this proposal</h2>
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        sections.slice(1).map((s, i) => (
          <li>
            <a
              href={href(s.slug)}
              class="group flex h-full flex-col rounded-xl bg-card p-6 shadow-xs ring-1 ring-foreground/10 hover:ring-primary/60"
            >
              <span class="text-xs font-semibold text-primary tabular-nums">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="mt-2 text-lg font-semibold group-hover:text-primary">
                {s.label}
              </span>
              <span class="mt-1 flex-1 text-sm text-muted-foreground">
                {s.blurb}
              </span>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary">
                Open <ArrowRight className="size-4" aria-hidden="true" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</AppLayout>
