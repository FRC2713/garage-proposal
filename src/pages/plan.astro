---
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PageNav from "../components/PageNav.astro";
import { phases } from "../data/proposal";
---

<AppLayout title="Phased plan | Garage robotics lab proposal">
  <PageHeader slug="plan" title="A phased plan" image="08-room6-build-assembly">
    Each phase ends with a usable space and a check-in with the district before
    the next one starts. Costs, funding, and dates for each phase will be
    confirmed with the district during Phase 1.
  </PageHeader>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <ol class="relative space-y-6 border-l-2 border-border pl-8">
      {
        phases.map((p) => (
          <li class="relative">
            <span class="absolute top-5 -left-[2.65rem] grid size-8 place-items-center rounded-full bg-primary text-sm font-bold text-primary-foreground ring-4 ring-background">
              {p.n}
            </span>
            <article class="rounded-xl bg-card p-6 shadow-xs ring-1 ring-foreground/10">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h2 class="flex items-center gap-2 text-lg font-semibold">
                  <p.icon className="size-5 text-primary" aria-hidden="true" />
                  Phase {p.n}: {p.title}
                </h2>
                <span class="rounded-full bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">
                  {p.timing}
                </span>
              </div>
              <ul class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
                {p.goals.map((g) => (
                  <li class="flex gap-2">
                    <span
                      aria-hidden="true"
                      class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"
                    />
                    <span>{g}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-4 border-t pt-4 text-sm">
                <strong>Outcome:</strong>{" "}
                <span class="text-muted-foreground">{p.outcome}</span>
              </p>
            </article>
          </li>
        ))
      }
    </ol>
  </section>

  <PageNav slug="plan" />
</AppLayout>
