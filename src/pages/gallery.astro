---
import { ChevronLeft, ChevronRight } from "lucide-react";
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PageNav from "../components/PageNav.astro";
import GarageViewer from "../components/islands/GarageViewer";
import { gallery, img } from "../data/proposal";

const modelUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/models/garage-option-b.glb`;
const tab =
  "rounded-md px-4 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground aria-pressed:bg-primary aria-pressed:text-primary-foreground";
const arrow =
  "absolute top-1/2 grid size-10 -translate-y-1/2 place-items-center rounded-full bg-background/90 text-foreground shadow-sm ring-1 ring-foreground/10 hover:bg-background disabled:opacity-0";
---

<AppLayout title="Gallery | Garage robotics lab proposal">
  <PageHeader
    slug="gallery"
    title="See the space"
    image="05-mezzanine-overlook"
  >
    Concept renderings of the proposed layout, from the same SketchUp model you
    can explore in 3D.
  </PageHeader>

  <section class="mx-auto max-w-6xl px-5 py-8">
    <div
      role="group"
      aria-label="How to view the layout"
      class="inline-flex gap-1 rounded-lg bg-card p-1 ring-1 ring-foreground/10"
    >
      <button type="button" data-view="images" aria-pressed="true" class={tab}>
        Renderings
      </button>
      <button type="button" data-view="3d" aria-pressed="false" class={tab}>
        View in 3D
      </button>
    </div>
  </section>

  <section
    data-panel="3d"
    class="mx-auto max-w-[96rem] px-2 pb-10 sm:px-4"
    hidden
  >
    <GarageViewer
      client:visible
      modelUrl={modelUrl}
      fallbackImage={img("01-aerial-cutaway-sw")}
    />
  </section>

  <section data-panel="images" class="mx-auto max-w-[96rem] px-2 pb-10 sm:px-4">
    <div
      data-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label="Renderings"
      class="overflow-hidden rounded-xl bg-card ring-1 ring-foreground/10"
    >
      <div class="relative bg-[#eef0f2]">
        <ul
          data-track
          tabindex="0"
          aria-label="Use the arrow keys to move between renderings"
          class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none] focus-visible:outline-2 focus-visible:outline-primary motion-reduce:scroll-auto [&::-webkit-scrollbar]:hidden"
        >
          {
            gallery.map((g, i) => (
              <li
                class="w-full shrink-0 snap-center"
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${gallery.length}`}
                data-text={g.caption}
                data-href={img(g.file)}
              >
                <img
                  src={img(g.file)}
                  alt={g.caption}
                  loading={i === 0 ? "eager" : "lazy"}
                  width="1920"
                  height="1080"
                  class="aspect-video max-h-[70vh] w-full object-contain"
                />
              </li>
            ))
          }
        </ul>
        <button
          type="button"
          data-prev
          aria-label="Previous rendering"
          class={`${arrow} left-2 sm:left-4`}
        >
          <ChevronLeft className="size-5" aria-hidden="true" />
        </button>
        <button
          type="button"
          data-next
          aria-label="Next rendering"
          class={`${arrow} right-2 sm:right-4`}
        >
          <ChevronRight className="size-5" aria-hidden="true" />
        </button>
      </div>
      <div
        class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-t px-4 py-3 text-sm"
      >
        <p data-current aria-live="polite" class="min-w-0 flex-1">
          {gallery[0]!.caption}
        </p>
        <span data-count class="text-muted-foreground tabular-nums">
          1 / {gallery.length}
        </span>
        <a
          data-open
          href={img(gallery[0]!.file)}
          target="_blank"
          rel="noopener"
          class="text-muted-foreground underline decoration-foreground/30 underline-offset-2 hover:text-primary hover:decoration-primary"
        >
          Open full size
        </a>
      </div>
      <div class="relative flex gap-2 overflow-x-auto border-t p-3">
        {
          gallery.map((g, i) => (
            <button
              type="button"
              data-thumb={i}
              aria-label={`Show rendering ${i + 1}: ${g.caption}`}
              aria-current={i === 0 ? "true" : "false"}
              class="shrink-0 overflow-hidden rounded-md opacity-60 ring-1 ring-foreground/10 transition hover:opacity-100 aria-[current=true]:opacity-100 aria-[current=true]:ring-2 aria-[current=true]:ring-primary"
            >
              <img
                src={img(g.file)}
                alt=""
                loading="lazy"
                width="160"
                height="90"
                class="aspect-video w-24 object-cover sm:w-32"
              />
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-view]");
    const panels = document.querySelectorAll<HTMLElement>("[data-panel]");

    function show(view: string) {
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.view === view)),
      );
      panels.forEach((p) => (p.hidden = p.dataset.panel !== view));
    }

    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const view = b.dataset.view!;
        show(view);
        history.replaceState(
          null,
          "",
          view === "3d" ? "#3d" : location.pathname,
        );
      }),
    );
    if (location.hash === "#3d") show("3d");

    const carousel = document.querySelector<HTMLElement>("[data-carousel]")!;
    const track = carousel.querySelector<HTMLElement>("[data-track]")!;
    const slides = [...track.children] as HTMLElement[];
    const thumbs = [
      ...carousel.querySelectorAll<HTMLButtonElement>("[data-thumb]"),
    ];
    const prev = carousel.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = carousel.querySelector<HTMLButtonElement>("[data-next]")!;
    const caption = carousel.querySelector<HTMLElement>("[data-current]")!;
    const count = carousel.querySelector<HTMLElement>("[data-count]")!;
    const open = carousel.querySelector<HTMLAnchorElement>("[data-open]")!;
    let current = 0;

    function update(i: number) {
      current = i;
      caption.textContent = slides[i]!.dataset.text!;
      count.textContent = `${i + 1} / ${slides.length}`;
      open.href = slides[i]!.dataset.href!;
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
      thumbs.forEach((t, j) => t.setAttribute("aria-current", String(j === i)));
      const thumb = thumbs[i]!;
      const strip = thumb.parentElement!;
      strip.scrollTo({
        left: thumb.offsetLeft - (strip.clientWidth - thumb.clientWidth) / 2,
      });
    }

    function go(i: number) {
      const to = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: to * track.clientWidth });
    }

    track.addEventListener("scroll", () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      if (i !== current) update(i);
    });
    prev.addEventListener("click", () => go(current - 1));
    next.addEventListener("click", () => go(current + 1));
    thumbs.forEach((t, j) => t.addEventListener("click", () => go(j)));
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") go(current - 1);
      else if (e.key === "ArrowRight") go(current + 1);
      else return;
      e.preventDefault();
    });
    update(0);
  </script>

  <PageNav slug="gallery" />
</AppLayout>
