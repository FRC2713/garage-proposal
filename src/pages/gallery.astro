---
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PageNav from "../components/PageNav.astro";
import { gallery, img } from "../data/proposal";
---

<AppLayout title="Gallery | Garage robotics lab proposal">
  <PageHeader
    slug="gallery"
    title="See the space"
    image="05-mezzanine-overlook"
  >
    Concept renderings of Option B. Select an image to open it full size.
  </PageHeader>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid gap-5 sm:grid-cols-2">
      {
        gallery.map((g, i) => (
          <figure
            class:list={[
              "group overflow-hidden rounded-xl bg-card ring-1 ring-foreground/10",
              i === 0 && "sm:col-span-2",
            ]}
          >
            <a
              href={img(g.file)}
              target="_blank"
              rel="noopener"
              class="block overflow-hidden"
            >
              <img
                src={img(g.file)}
                alt={g.caption}
                loading={i < 2 ? "eager" : "lazy"}
                width="1920"
                height="1080"
                class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none"
              />
            </a>
            <figcaption class="px-4 py-3 text-sm text-muted-foreground">
              {g.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <PageNav slug="gallery" />
</AppLayout>
