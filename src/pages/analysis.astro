---
import { CheckCircle2 } from "lucide-react";
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PageNav from "../components/PageNav.astro";
import { comparison, img, safety, spaces } from "../data/proposal";
---

<AppLayout title="Analysis | Garage robotics lab proposal">
  <PageHeader
    slug="analysis"
    title="What the space can hold"
    image="02-floor-plan-top"
  >
    We modeled the garage and adjoining rooms in 3D to test how a working
    robotics program fits. Dimensions come from that model and should be
    confirmed on site.
  </PageHeader>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="text-xl font-semibold">The spaces</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        spaces.map((s) => (
          <article class="flex gap-4 rounded-xl bg-card p-5 ring-1 ring-foreground/10">
            <div class="grid size-10 shrink-0 place-items-center rounded-lg bg-accent text-accent-foreground">
              <s.icon className="size-5" aria-hidden="true" />
            </div>
            <div>
              <h3 class="font-semibold">
                {s.name}
                <span class="ml-2 text-sm font-normal text-muted-foreground tabular-nums">
                  {s.size}
                </span>
              </h3>
              <p class="mt-1 text-sm text-muted-foreground">{s.use}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-y bg-card">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-xl font-semibold">Storage today versus a lab</h2>
      <div class="mt-6 overflow-x-auto rounded-xl ring-1 ring-foreground/10">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead class="bg-muted text-foreground">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold"
                ><span class="sr-only">Topic</span></th
              >
              <th scope="col" class="px-4 py-3 font-semibold">Storage only</th>
              <th scope="col" class="px-4 py-3 font-semibold"
                >Robotics lab (Option B)</th
              >
            </tr>
          </thead>
          <tbody class="divide-y bg-card">
            {
              comparison.map((r) => (
                <tr>
                  <th scope="row" class="px-4 py-3 font-medium">
                    {r.topic}
                  </th>
                  <td class="px-4 py-3 text-muted-foreground">{r.storage}</td>
                  <td class="px-4 py-3">{r.lab}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-2">
    <div>
      <h2 class="text-xl font-semibold">Why Option B</h2>
      <p class="mt-3 text-muted-foreground">
        We studied two layouts. Option A turned the field east–west and filled
        the garage with pit benches and long-stock racks. Option B uses a
        3/4-scale field running north–south. It leaves the existing mezzanine
        and pallet racking in place and puts metal prep beneath the mezzanine,
        beside the cage. That keeps the district's storage structures, shortens
        the walk between fabrication and the field, and leaves open aisles on
        both sides of the field.
      </p>
      <figure class="mt-6 overflow-hidden rounded-xl ring-1 ring-foreground/10">
        <img
          src={img("02-floor-plan-top")}
          alt="Plan view of the Option B layout showing the field, cage, Room 6, and Room 3"
          loading="lazy"
          class="w-full"
        />
        <figcaption class="bg-card px-4 py-3 text-xs text-muted-foreground">
          Option B plan view. Labels mark the field, cage, staging, and
          classroom.
        </figcaption>
      </figure>
    </div>
    <div>
      <h2 class="text-xl font-semibold">Safety designed in</h2>
      <ul class="mt-4 space-y-3">
        {
          safety.map((s) => (
            <li class="flex gap-3 text-sm">
              <CheckCircle2
                className="mt-0.5 size-4 shrink-0 text-primary"
                aria-hidden="true"
              />
              <span>{s}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <PageNav slug="analysis" />
</AppLayout>
