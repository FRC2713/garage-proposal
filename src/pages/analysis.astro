---
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PageNav from "../components/PageNav.astro";
import LayoutPlan from "../components/LayoutPlan.astro";
import SpacePerStudent from "../components/SpacePerStudent.astro";
import {
  comparison,
  currentRooms,
  href,
  img,
  labArea,
  program,
  roundArea,
  size,
  spaceContextSources,
  spaceStandards,
  spaces,
} from "../data/proposal";

const fmt = (n: number) => Math.floor(n).toLocaleString("en-US");
const perPersonNow = Math.round(currentRooms.sqft / currentRooms.people);
const frcStudents = parseInt(program[1]!.value);
const perStudent = spaceStandards.map((s) => s.perPerson);
const minPer = Math.min(...perStudent);
const maxPer = Math.max(...perStudent);
const link =
  "underline decoration-foreground/30 underline-offset-2 hover:text-primary hover:decoration-primary";
---

<AppLayout title="Analysis | Garage robotics lab proposal">
  <PageHeader
    slug="analysis"
    title="Why we need the garage, and what it can hold"
    image="06-under-mezzanine-metal-prep"
  >
    We modeled the garage and adjoining rooms in 3D to test how a working
    robotics program fits. Dimensions come from that model and should be
    confirmed on site.
  </PageHeader>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="text-xl font-semibold">We have outgrown Rooms 3 and 6</h2>
    <div class="mt-3 grid gap-6 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div class="space-y-3 text-muted-foreground">
        <p>
          The team works today in Rooms 3 and 6, about {
            fmt(roundArea(currentRooms.sqft))
          } sq ft together. We regularly have more than {currentRooms.people} people
          in them, about {perPersonNow} sq ft each.
        </p>
        <p>
          Shop and lab standards call for at least {minPer} to {maxPer} sq ft per
          student. By those measures the two rooms support {
            fmt(currentRooms.sqft / maxPer)
          } to {fmt(currentRooms.sqft / minPer)} students, so we are already past
          capacity. To give today's students the space these standards call for, and
          to take on more, we need more floor area.
        </p>
        <p>
          The {frcStudents}-student FRC team alone needs {
            fmt(frcStudents * minPer)
          } to {fmt(frcStudents * maxPer)} sq ft. The proposed lab, about {
            fmt(roundArea(labArea))
          } sq ft, meets {
            spaceStandards.filter((s) => frcStudents * s.perPerson <= labArea)
              .length
          } of these {spaceStandards.length} standards for the current team, although
          the practice field takes up much of the garage floor.
        </p>
      </div>
      <SpacePerStudent />
    </div>

    <div class="mt-8 overflow-x-auto rounded-xl ring-1 ring-foreground/10">
      <table class="w-full min-w-[44rem] text-left text-sm">
        <thead class="bg-muted text-foreground">
          <tr>
            <th scope="col" class="px-4 py-3 font-semibold">Standard</th>
            <th scope="col" class="px-4 py-3 text-right font-semibold"
              >Minimum sq ft per student</th
            >
            <th scope="col" class="px-4 py-3 text-right font-semibold"
              >Students Rooms 3 and 6 support</th
            >
            <th scope="col" class="px-4 py-3 text-right font-semibold"
              >Sq ft for {currentRooms.people} people</th
            >
            <th scope="col" class="px-4 py-3 text-right font-semibold"
              >Sq ft for {frcStudents} FRC students</th
            >
          </tr>
        </thead>
        <tbody class="divide-y bg-card">
          {
            spaceStandards.map((s) => (
              <tr>
                <th scope="row" class="px-4 py-3 font-normal">
                  <span class="font-medium">{s.benchmark}</span>
                  <span class="block text-xs text-muted-foreground">
                    {s.kind} ·{" "}
                    <a href={s.source.url} class={link} rel="noopener">
                      {s.source.label}
                    </a>
                  </span>
                </th>
                <td class="px-4 py-3 text-right tabular-nums">{s.perPerson}</td>
                <td class="px-4 py-3 text-right tabular-nums">
                  {fmt(currentRooms.sqft / s.perPerson)}
                </td>
                <td class="px-4 py-3 text-right tabular-nums">
                  {fmt(currentRooms.people * s.perPerson)}
                </td>
                <td class="px-4 py-3 text-right tabular-nums">
                  {fmt(frcStudents * s.perPerson)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="mt-4 space-y-2 text-xs leading-relaxed text-muted-foreground">
      <p>
        Room areas come from our 3D model and include space taken by furniture
        and equipment, so the real net area, and the number of students the
        rooms support, is smaller. A plain classroom needs 20 sq ft per person
        by code, but most of our work is shop and lab work.
      </p>
      <p>
        For context, a 2020 national study of STEM and CTE teachers found only
        26% had a room over 1,250 sq ft, enough for 25 or more people at 50 sq
        ft each. Georgia and Maine size CTE labs by program rather than per
        student: 1,870–2,990 sq ft for Georgia's engineering labs (2012) and
        1,775 sq ft for Maine's Applied Engineering Technologies program (2025).{
          " "
        }
        {
          spaceContextSources.map((s, i) => (
            <>
              {i > 0 && " · "}
              <a href={s.url} class={link} rel="noopener">
                {s.label}
              </a>
            </>
          ))
        }
      </p>
      <p>
        These are working benchmarks. Massachusetts does not publish a
        per-student shop standard that we have found, and the state building
        code's table and how each room is classified still need to be confirmed
        with the building inspector and fire department.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl border-t px-5 py-16">
    <h2 class="text-xl font-semibold">The proposed lab</h2>
    <p class="mt-2 max-w-3xl text-muted-foreground">
      Four connected spaces, about {fmt(roundArea(labArea))} sq ft in all. Sizes come
      from our 3D model.
    </p>
    <div class="mt-6">
      <LayoutPlan />
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        spaces.map((s) => (
          <article class="flex gap-4 rounded-xl bg-card p-5 ring-1 ring-foreground/10">
            <div class="grid size-10 shrink-0 place-items-center rounded-lg bg-accent text-accent-foreground">
              <s.icon className="size-5" aria-hidden="true" />
            </div>
            <div>
              <h3 class="font-semibold">
                {s.name}
                <span class="ml-2 text-sm font-normal text-muted-foreground tabular-nums">
                  {size(s)} · ≈ {fmt(s.ft[0] * s.ft[1])} sq ft
                </span>
              </h3>
              <p class="mt-1 text-sm text-muted-foreground">{s.use}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-[1.3fr_1fr]"
  >
    <div>
      <h2 class="text-xl font-semibold">Why this layout</h2>
      <p class="mt-3 text-muted-foreground">
        The practice field, full width and 3/4 of full length, runs north–south
        in the garage bay. The layout reuses the existing mezzanine and pallet
        racking for lab storage and puts metal prep beneath the mezzanine,
        beside the cage. That avoids building new storage, shortens the walk
        between fabrication and the field, and leaves open aisles on both sides
        of the field.
      </p>
      <figure class="mt-6 overflow-hidden rounded-xl ring-1 ring-foreground/10">
        <img
          src={img("02-floor-plan-top")}
          alt="Plan view of the proposed layout showing the field, cage, Room 6, and Room 3"
          loading="lazy"
          class="w-full"
        />
        <figcaption class="bg-card px-4 py-3 text-xs text-muted-foreground">
          Plan view with equipment labels: the field, cage, staging, and
          classroom.
        </figcaption>
      </figure>
    </div>
    <div class="lg:pt-10">
      <h2 class="text-xl font-semibold">Safety designed in</h2>
      <p class="mt-3 text-muted-foreground">
        The layout separates hazards by zone. Laser and metal fabrication sit in
        a fenced cage with its own exhaust; metal prep is screened under the
        mezzanine; battery charging stays in Room 6, away from fabrication; and
        the field has gated sides and a marked egress lane.
      </p>
      <p class="mt-3 text-muted-foreground">
        Each control arrives with the step that opens the space it protects, so
        nothing opens without its controls in place. The{" "}
        <a href={href("plan")} class={link}>two-track plan</a> lists them step by
        step.
      </p>
    </div>
  </section>

  <section class="border-y bg-card">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-xl font-semibold">Storage today versus a lab</h2>
      <div class="mt-6 overflow-x-auto rounded-xl ring-1 ring-foreground/10">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead class="bg-muted text-foreground">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold"
                ><span class="sr-only">Topic</span></th
              >
              <th scope="col" class="px-4 py-3 font-semibold">Storage only</th>
              <th scope="col" class="px-4 py-3 font-semibold">Robotics lab</th>
            </tr>
          </thead>
          <tbody class="divide-y bg-card">
            {
              comparison.map((r) => (
                <tr>
                  <th scope="row" class="px-4 py-3 font-medium">
                    {r.topic}
                  </th>
                  <td class="px-4 py-3 text-muted-foreground">{r.storage}</td>
                  <td class="px-4 py-3">{r.lab}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <PageNav slug="analysis" />
</AppLayout>
