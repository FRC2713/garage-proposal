---
import { program, programTeams } from "../data/proposal";
---

<div class="grid gap-6 lg:grid-cols-[1.6fr_1fr]">
  <dl
    class="grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-border ring-1 ring-foreground/10"
  >
    {
      program.map((s) => (
        <div class="bg-card px-5 py-5">
          <dt class="text-xs text-muted-foreground">{s.label}</dt>
          <dd class="mt-1 text-2xl font-bold tracking-tight tabular-nums">
            {s.value}
          </dd>
        </div>
      ))
    }
  </dl>
  <div class="rounded-xl bg-card p-5 ring-1 ring-foreground/10">
    <h3 class="text-sm font-semibold">10–11 teams in one program</h3>
    <ul class="mt-3 divide-y text-sm">
      {
        programTeams.map((t) => (
          <li class="flex items-baseline gap-3 py-2">
            <span class="w-10 shrink-0 text-lg font-bold text-primary tabular-nums">
              {t.count}
            </span>
            <span>
              <span class="font-medium">{t.name}</span>
              <span class="block text-xs text-muted-foreground">{t.note}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
