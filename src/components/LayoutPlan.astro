---
import { ArrowRight } from "lucide-react";
import { planRooms } from "../data/proposal";

interface Props {
  /** Leave out the room key under the plans. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Lab rooms tinted on the school plan, in image pixels.
const existingAreas: [number, number, number, number][] = [
  [552, 28, 867, 278],
  [552, 280, 660, 378],
  [452, 222, 550, 378],
  [765, 280, 891, 378],
];

// Lab room outlines on the proposed plan, in inches from its top-left corner.
const proposedAreas = [
  "250,830 498,830 498,604 970,604 970,22 250,22",
  "250,604 498,604 498,830 250,830",
  "19,830 243,830 243,471 81,471 81,518 52,518 52,615 19,615",
  "735,610 1023,610 1023,831 735,831",
];

const pillWidth = (text: string, fs: number) => text.length * fs * 0.58 + fs;
const labRooms = planRooms.filter((r) => r.inLab);
const otherRooms = planRooms.filter((r) => !r.inLab);
---

<figure class="rounded-xl bg-card p-4 ring-1 ring-foreground/10 sm:p-5">
  <div class="flex flex-col gap-4 md:flex-row md:items-center">
    {
      [
        {
          title: "Today: school floor plan (May 2019)",
          src: `${base}/images/plan-existing.png`,
          w: 980,
          h: 520,
          at: "existing" as const,
          alt: "Second-floor plan of Melrose High School around the garage, with part of the gym and the weight room for reference. The garage, cage, Room 6, and Room 3 are shaded.",
        },
        {
          title: "Proposed robotics lab",
          src: `${base}/images/plan-proposed.jpg`,
          w: 1200,
          h: 850,
          at: "proposed" as const,
          alt: "Plan view of the proposed lab: practice field and mezzanine in the garage bay, fabrication cage, Room 6 for build and assembly, and Room 3 as a classroom.",
        },
      ]
        .map((p) => ({ ...p, fs: p.w / 40 }))
        .map((p, i) => (
          <>
            {i === 1 && (
              <ArrowRight
                className="mx-auto size-6 shrink-0 rotate-90 text-muted-foreground md:rotate-0"
                aria-hidden="true"
              />
            )}
            <div class="min-w-0" style={`flex: ${p.w / p.h} 1 0%`}>
              <p class="mb-2 text-xs font-semibold text-muted-foreground">
                {p.title}
              </p>
              <svg
                viewBox={`0 0 ${p.w} ${p.h}`}
                role="img"
                aria-label={p.alt}
                class="block h-auto w-full rounded-lg ring-1 ring-foreground/10"
              >
                <image href={p.src} width={p.w} height={p.h} />
                {p.at === "existing"
                  ? existingAreas.map(([x0, y0, x1, y1]) => (
                      <rect
                        x={x0}
                        y={y0}
                        width={x1 - x0}
                        height={y1 - y0}
                        class="fill-primary/15 stroke-primary"
                        stroke-width="3"
                      />
                    ))
                  : proposedAreas.map((pts) => (
                      <polygon
                        points={pts}
                        class="fill-none stroke-primary"
                        stroke-width="6"
                      />
                    ))}
                {otherRooms.map((r) => (
                  <g transform={`translate(${r[p.at].join(",")})`}>
                    <circle
                      r={p.fs * 0.8}
                      fill="white"
                      class="stroke-muted-foreground"
                      stroke-width={p.fs / 10}
                    />
                    <text
                      text-anchor="middle"
                      dominant-baseline="central"
                      font-size={p.fs * 0.9}
                      font-weight="700"
                      class="fill-muted-foreground"
                    >
                      {r.mark}
                    </text>
                  </g>
                ))}
                {labRooms.map((r) => (
                  <g transform={`translate(${r[p.at].join(",")})`}>
                    <rect
                      x={-pillWidth(r.name, p.fs) / 2}
                      y={-p.fs * 0.8}
                      width={pillWidth(r.name, p.fs)}
                      height={p.fs * 1.6}
                      rx={p.fs * 0.8}
                      class="fill-primary"
                    />
                    <text
                      text-anchor="middle"
                      dominant-baseline="central"
                      font-size={p.fs}
                      font-weight="600"
                      fill="white"
                    >
                      {r.name}
                    </text>
                  </g>
                ))}
              </svg>
            </div>
          </>
        ))
    }
  </div>
  {
    !compact && (
      <figcaption class="mt-5 border-t pt-4">
        <dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
          {labRooms.map((r) => (
            <div>
              <dt class="font-semibold">
                {r.name}
                <span class="font-normal text-muted-foreground">
                  {" "}
                  · {r.schoolName} on the school plan
                </span>
              </dt>
              <dd class="text-muted-foreground">{r.use}</dd>
            </div>
          ))}
          <div class="sm:col-span-2">
            <dt class="font-semibold">
              Rooms {otherRooms.map((r) => r.mark).join(", ")}
            </dt>
            <dd class="text-muted-foreground">
              Shown for reference. They are not part of this proposal.
            </dd>
          </div>
        </dl>
      </figcaption>
    )
  }
  {
    compact && (
      <figcaption class="mt-3 text-xs text-muted-foreground">
        The lab uses the garage bay, cage, Room 6, and Room 3, outlined in red.
        Rooms {otherRooms.map((r) => r.mark).join(", ")} are not part of this
        proposal.
      </figcaption>
    )
  }
</figure>
